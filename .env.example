# Local dev only — copy to `.env` (gitignored) before running `docker compose up`.
# docker compose loads `.env` from this directory automatically (macOS, Windows, Linux).
# These same values are the defaults baked into backend/src/main/resources/application.yml,
# so the backend connects out of the box without exporting anything.
DB_NAME=shopping_plugin
DB_USERNAME=shopping_plugin
DB_PASSWORD=shopping_plugin
