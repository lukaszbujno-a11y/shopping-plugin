#!/usr/bin/env bash
# Checks commit messages for English grammar/spelling via the LanguageTool
# public API. Blocks the commit on any finding by default (silent warnings
# in VS Code's Source Control panel go unnoticed — see docs/DECISIONS.md
# ADR-004). Set COMMIT_MSG_STRICT=0 to downgrade to a warning for one
# commit, or use `git commit --no-verify` to skip the check entirely.
set -euo pipefail

commit_msg_file="$1"

# Strip git's own comment lines (e.g. "# Please enter the commit message...")
msg="$(grep -v '^#' "$commit_msg_file" || true)"
subject="$(printf '%s\n' "$msg" | head -n1)"

# Nothing to check, or a commit type that's exempt from prose review.
case "$subject" in
  ""|Merge\ *|fixup!*|squash!*) exit 0 ;;
esac

if ! command -v curl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  echo "⚠️  commit-msg: curl/jq not found — skipping English check." >&2
  exit 0
fi

# UPPERCASE_SENTENCE_START is disabled: `type(scope): opis` intentionally
# lowercases the text after the colon, which the rule can't distinguish
# from a real sentence-start error.
response="$(curl -s --fail --max-time 10 \
  --data-urlencode "text=${msg}" \
  --data "language=en-US" \
  --data "disabledRules=UPPERCASE_SENTENCE_START" \
  "https://api.languagetool.org/v2/check" 2>/dev/null)" || {
  echo "⚠️  commit-msg: could not reach LanguageTool API — skipping English check." >&2
  exit 0
}

count="$(printf '%s' "$response" | jq '.matches | length' 2>/dev/null || echo 0)"

if [ "${count:-0}" -gt 0 ]; then
  echo "" >&2
  echo "📝 LanguageTool found $count issue(s) in your commit message:" >&2
  echo "" >&2
  printf '%s' "$response" | jq -r '.matches[] | "  • \(.message)\n    → \"\(.context.text)\"\n"' >&2

  if [ "${COMMIT_MSG_STRICT:-1}" = "0" ]; then
    echo "ℹ️  COMMIT_MSG_STRICT=0 — warning only, commit proceeds." >&2
    echo "" >&2
  else
    echo "❌ Fix the issues above, retry, or commit with --no-verify / COMMIT_MSG_STRICT=0." >&2
    exit 1
  fi
fi

exit 0
